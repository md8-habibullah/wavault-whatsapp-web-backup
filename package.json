{
  "name": "wavault",
  "version": "1.0.0",
  "description": "Free, open-source browser extension to export WhatsApp contacts, group members, chat history, media and statuses from WhatsApp Web to CSV, Excel, vCard, Google Contacts, Outlook, JSON, HTML and PDF.",
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "whatsapp-business",
    "whatsapp-backup",
    "whatsapp-contacts",
    "export-contacts",
    "contact-exporter",
    "group-members-export",
    "chat-backup",
    "status-downloader",
    "vcard",
    "csv",
    "excel",
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "edge-extension",
    "safari-extension",
    "wxt",
    "react"
  ],
  "homepage": "https://md8-habibullah.github.io/wavault-whatsapp-web-backup/",
  "bugs": {
    "url": "https://github.com/md8-habibullah/wavault-whatsapp-web-backup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/md8-habibullah/wavault-whatsapp-web-backup.git"
  },
  "license": "MIT",
  "author": {
    "name": "MD. Habibullah Sharif",
    "email": "hello@habibullah.dev",
    "url": "https://habibullah.dev"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "wxt build && wxt build -b edge && wxt build -b firefox && wxt build -b safari",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "zip:all": "wxt zip && wxt zip -b edge && wxt zip -b firefox",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv2",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node scripts/e2e.mjs",
    "postinstall": "wxt prepare",
    "preview": "vite --config preview/vite.config.js",
    "screenshots": "node scripts/screenshots.mjs",
    "site": "node scripts/build-site.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.1.3",
    "puppeteer-core": "25.14.0",
    "vitest": "5.0.5",
    "web-ext": "10.8.0",
    "wxt": "0.21.4"
  }
}
